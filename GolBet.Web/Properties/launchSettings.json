{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "GolBet local": {
      "commandName": "Executable",
      "executablePath": "..\\.tools\\dotnet\\dotnet.exe",
      "commandLineArgs": "bin\\Debug\\net8.0\\GolBet.Web.dll",
      "workingDirectory": ".",
      "launchBrowser": true,
      "launchUrl": "http://localhost:5229",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5229"
      }
    },
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5229",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:7253;http://localhost:5229",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
