@* Views/Teams/Index.cshtml *@
@model IEnumerable<GolBet.Services.DTOs.TeamDto>
@{
    ViewData["Title"] = "Equipos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Equipos</h2>
    <a asp-action="Create" class="btn btn-success">+ Nuevo equipo</a>
</div>

<div class="table-responsive">
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th></th>
            <th>Nombre</th>
            <th>Ciudad</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var team in Model)
        {
            <tr>
                <td style="width:60px">
                    <img src="@(team.CrestUrl ?? "/images/crests/fc.svg")"
                         width="40" height="40" alt="@team.Name" />
                </td>
                <td class="fw-bold">@team.Name</td>
                <td>@team.City</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@team.Id"
                       class="btn btn-sm btn-outline-primary">Editar</a>
                    <form asp-action="Deactivate" asp-route-id="@team.Id" method="post"
                          class="d-inline"
                          data-confirm="¿Desactivar el equipo @team.Name?">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            Desactivar
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
@if (!Model.Any()) { <p class="text-muted">No hay equipos activos. Crea un equipo para comenzar.</p> }
